---
import { Image } from "astro:assets";
import MunusWelcomeImg from "../assets/MunusWelcome.png";
import Munus from "../assets/MUNUS.svg";
import LoginIcon from "../assets/LoginIcon.svg";

console.log("aparece no terminal");
---

<main class="p-10 h-dvh flex flex-col items-center justify-between">
    <header
        class="py-5 px-10 h-20 w-full flex items-center justify-between bg-primary rounded-4xl shadow-xl"
    >
        <div>
            <Image src={Munus} alt="" />
        </div>

        <a href="/app/" class="flex gap-2 items-center">
            <Image src={LoginIcon} alt="" />
            <span class="text-2xl font-sans">Login</span>
        </a>
    </header>

    <section>
        <div class="mx-auto max-w-300">
            <Image src={MunusWelcomeImg} alt="Munus - Your taks. In order." />
        </div>
    </section>

    <footer class="text-lg">Munus - Alguns direiros reservados.</footer>
</main>

